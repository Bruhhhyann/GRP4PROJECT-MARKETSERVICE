<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 520" role="img" aria-label="Service worker placeholder" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <circle cx="240" cy="270" r="215" fill="#f5b83d"/>
  <circle cx="240" cy="270" r="215" fill="none" stroke="#ffffff" stroke-opacity=".35" stroke-width="3" stroke-dasharray="4 14"/>
  <!-- body / vest -->
  <path d="M110 500 C110 380 160 330 240 330 C320 330 370 380 370 500 Z" fill="#1f8a8a"/>
  <path d="M170 340 L240 420 L310 340 C290 332 265 330 240 330 C215 330 190 332 170 340 Z" fill="#ffffff"/>
  <path d="M135 470 C140 400 170 350 205 336 L215 500 L135 500 Z" fill="#ff8a1f"/>
  <path d="M345 470 C340 400 310 350 275 336 L265 500 L345 500 Z" fill="#ff8a1f"/>
  <rect x="150" y="440" width="60" height="12" fill="#ffffff" opacity=".85" transform="rotate(-8 180 446)"/>
  <rect x="270" y="440" width="60" height="12" fill="#ffffff" opacity=".85" transform="rotate(8 300 446)"/>
  <!-- neck + head -->
  <rect x="216" y="296" width="48" height="44" rx="14" fill="#d79a73"/>
  <ellipse cx="240" cy="250" rx="62" ry="70" fill="#e8b08a"/>
  <ellipse cx="180" cy="256" rx="10" ry="16" fill="#e8b08a"/>
  <ellipse cx="300" cy="256" rx="10" ry="16" fill="#e8b08a"/>
  <!-- face -->
  <circle cx="218" cy="250" r="6" fill="#1b2430"/>
  <circle cx="262" cy="250" r="6" fill="#1b2430"/>
  <path d="M214 285 Q240 308 266 285" fill="none" stroke="#1b2430" stroke-width="5" stroke-linecap="round"/>
  <!-- hard hat -->
  <path d="M168 224 C168 160 205 132 240 132 C275 132 312 160 312 224 Z" fill="#0e2a47"/>
  <rect x="152" y="220" width="176" height="20" rx="10" fill="#163a5f"/>
  <rect x="226" y="132" width="28" height="60" rx="8" fill="#163a5f"/>
  <!-- wrench in hand -->
  <g transform="rotate(35 365 400)">
    <rect x="355" y="330" width="20" height="130" rx="8" fill="#c8d6e4"/>
    <path d="M342 330 a33 33 0 0 1 46 0 l-10 22 h-26 z" fill="#c8d6e4"/>
    <rect x="366" y="326" width="0" height="0" fill="none"/>
